rules_version = '2';

// O app não usa Firebase Auth: o acesso é protegido pelo conhecimento do
// nome + senha do compartimento (o cliente valida o hash SHA-256).
// Estas regras impedem a enumeração de compartimentos, tornam o hash da
// senha imutável e validam a estrutura básica dos documentos.
service cloud.firestore {
  match /databases/{database}/documents {

    match /compartments/{compartmentId} {
      // get: necessário para abrir/validar um compartimento pelo id.
      // list: bloqueado para não permitir enumerar compartimentos alheios.
      allow get: if true;
      allow list: if false;

      allow create: if request.resource.data.keys().hasAll(['name', 'passwordHash', 'currentMonth', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.passwordHash is string
                    && request.resource.data.passwordHash.size() == 64
                    && request.resource.data.currentMonth is string
                    && request.resource.data.currentMonth.matches('[0-9]{4}-[0-9]{2}');

      // Só o mês corrente, a renda mensal líquida e as preferências de leitura
      // da tela Adicionar (o modo, importar fatura ou lançar à mão, e no card
      // de estatísticas a categoria e a origem acompanhadas e a aba aberta)
      // podem mudar; nome e hash da senha são imutáveis. As preferências e a
      // renda ficam aqui, e não no dispositivo, para valerem em qualquer
      // aparelho.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['currentMonth', 'weekCategoryId', 'weekOriginId',
                                   'addStatsTab', 'monthlyIncome', 'addMode'])
                    && request.resource.data.currentMonth is string
                    && request.resource.data.currentMonth.matches('[0-9]{4}-[0-9]{2}')
                    && (!('weekCategoryId' in request.resource.data)
                        || request.resource.data.weekCategoryId == null
                        || request.resource.data.weekCategoryId is string)
                    && (!('weekOriginId' in request.resource.data)
                        || request.resource.data.weekOriginId == null
                        || request.resource.data.weekOriginId is string)
                    && (!('addStatsTab' in request.resource.data)
                        || request.resource.data.addStatsTab in ['month', 'category', 'origin'])
                    && (!('addMode' in request.resource.data)
                        || request.resource.data.addMode in ['import', 'manual'])
                    // Renda mensal líquida em centavos. Opcional porque o
                    // compartimento criado antes do campo existir não tem a
                    // chave, e sem essa folga até trocar o mês corrente dele
                    // passaria a ser recusado.
                    && (!('monthlyIncome' in request.resource.data)
                        || (request.resource.data.monthlyIncome is int
                            && request.resource.data.monthlyIncome >= 0));

      allow delete: if false;

      match /fixedExpenses/{expenseId} {
        allow read: if true;
        // O gasto fixo não tem mais gasto ideal separado: o valor da conta é o
        // próprio previsto do mês. `idealAmount` continua aceito, e validado,
        // porque o cadastro gravado antes da mudança ainda carrega a chave.
        // `planId` liga o gasto fixo de planejamento ao plano que o criou;
        // opcional porque o gasto fixo comum e o cadastrado antes do campo não
        // têm a chave. `importKey` é a chave da compra parcelada que veio de
        // uma fatura importada, e só existe nesse caso.
        allow create, update: if request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.amount is int
                              && request.resource.data.amount >= 0
                              && (!('idealAmount' in request.resource.data)
                                  || (request.resource.data.idealAmount is int
                                      && request.resource.data.idealAmount >= 0))
                              && (!('planId' in request.resource.data)
                                  || request.resource.data.planId == null
                                  || request.resource.data.planId is string)
                              && (!('importKey' in request.resource.data)
                                  || request.resource.data.importKey is string);
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow create, update: if request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.idealAmount is int
                              && request.resource.data.idealAmount >= 0;
        allow delete: if false;
      }

      // Origem do gasto (forma de pagamento): cadastro do compartimento, no
      // mesmo modelo das categorias. Sem este bloco o Firestore nega tudo, e o
      // app não consegue nem listar nem criar origem.
      match /origins/{originId} {
        allow read: if true;
        // `idealAmount` é o gasto ideal do mês da origem, no mesmo modelo do
        // ideal da categoria. Opcional na validação porque a origem cadastrada
        // antes do campo existir não tem a chave, e sem essa folga trocar a
        // padrão ou a ordem dela passaria a ser recusado.
        allow create, update: if request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 100
                              && request.resource.data.icon is string
                              && request.resource.data.color is string
                              && request.resource.data.isDefault is bool
                              && request.resource.data.active is bool
                              && (!('idealAmount' in request.resource.data)
                                  || (request.resource.data.idealAmount is int
                                      && request.resource.data.idealAmount >= 0));
        // Remoção é desativação (active: false), como nos demais cadastros.
        allow delete: if false;
      }

      // Planejamento financeiro: projeção do que se guarda por mês, com
      // rendimento opcional de renda fixa. Guarda as entradas da simulação; o
      // resultado é calculado no app. Dinheiro em centavos e taxas em
      // centésimos de ponto percentual, os dois inteiros. Sem este bloco a aba
      // Planejamento não lista nem grava plano.
      //
      // `trackedFrom` (mês em que o plano entrou nos gastos fixos) e `progress`
      // (o planejado e o guardado de cada mês fechado, gravado na virada) são o
      // acompanhamento do plano em curso. Opcionais porque o plano criado antes
      // deles e o que nunca entrou nos gastos fixos não têm as chaves.
      match /plans/{planId} {
        allow read: if true;
        allow create, update: if request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 100
                              && request.resource.data.kind in ['accumulate', 'goal']
                              && request.resource.data.monthlyAmount is int
                              && request.resource.data.monthlyAmount >= 0
                              && request.resource.data.targetAmount is int
                              && request.resource.data.targetAmount >= 0
                              && request.resource.data.initialAmount is int
                              && request.resource.data.initialAmount >= 0
                              && request.resource.data.durationMonths is int
                              && request.resource.data.durationMonths >= 1
                              && request.resource.data.durationMonths <= 600
                              && request.resource.data.durationUnit in ['months', 'years']
                              && request.resource.data.startMonth is string
                              && request.resource.data.startMonth.matches('[0-9]{4}-[0-9]{2}')
                              && request.resource.data.rateMode in ['none', 'annual', 'cdi']
                              && request.resource.data.annualRate is int
                              && request.resource.data.annualRate >= 0
                              && request.resource.data.cdiRate is int
                              && request.resource.data.cdiRate >= 0
                              && request.resource.data.cdiPercent is int
                              && request.resource.data.cdiPercent >= 0
                              && request.resource.data.incomeTax is bool
                              && request.resource.data.active is bool
                              && (!('trackedFrom' in request.resource.data)
                                  || request.resource.data.trackedFrom == null
                                  || (request.resource.data.trackedFrom is string
                                      && request.resource.data.trackedFrom.matches('[0-9]{4}-[0-9]{2}')))
                              && (!('progress' in request.resource.data)
                                  || request.resource.data.progress is map);
        // Remoção é desativação (active: false), como nos demais cadastros.
        allow delete: if false;
      }

      // Configurações do compartimento que guardam segredo. Hoje só `ai`
      // (fila de modelos de IA e instruções). A chave de API chega aqui já
      // cifrada no app com a chave derivada da senha do compartimento, porque
      // a leitura é aberta a quem sabe o id, como em todo o resto. Apagar é a
      // ação "Remover" da tela de IA.
      match /settings/{settingId} {
        allow read: if true;
        allow create, update: if settingId == 'ai'
                              && request.resource.data.keys().hasOnly(['chain', 'instructions', 'updatedAt'])
                              && request.resource.data.chain is list
                              && request.resource.data.chain.size() <= 6
                              && request.resource.data.instructions is map
                              && request.resource.data.updatedAt is int;
        allow delete: if settingId == 'ai';
      }

      // Registro de importação de fatura: um documento por compra que já
      // passou pela revisão, com id igual ao hash da chave da compra. É o que
      // faz a importação criar só o que ainda não entrou, em qualquer mês.
      // `until` é o último mês em que a compra parcelada ainda aparece nas
      // faturas (null na compra à vista). O update existe porque a mesma chave
      // volta a ser gravada quando uma compra parcelada idêntica entra depois
      // do fim da anterior. Não se apaga: o registro é o histórico do que já
      // foi importado.
      match /importedItems/{itemId} {
        allow read: if true;
        allow create, update: if request.resource.data.kind in ['expense', 'fixed', 'skipped']
                              && request.resource.data.key is string
                              && request.resource.data.key.size() > 0
                              && request.resource.data.ym is string
                              && request.resource.data.ym.matches('[0-9]{4}-[0-9]{2}')
                              && request.resource.data.refId is string
                              && request.resource.data.amount is int
                              && request.resource.data.amount >= 0
                              && (request.resource.data.until == null
                                  || (request.resource.data.until is string
                                      && request.resource.data.until.matches('[0-9]{4}-[0-9]{2}')))
                              && request.resource.data.createdAt is int;
        allow delete: if false;
      }

      match /months/{monthId} {
        allow read: if true;
        // `currentWeek` é a semana corrente do mês (1 a 4), que o usuário vira
        // no botão da aba Adicionar; o mês nasce na semana 1. `income` é a
        // renda líquida daquele mês, copiada do compartimento quando o mês
        // nasce: é ela que o resumo do mês usa como referência do restante, e
        // fica no mês para que mudar a renda hoje não reescreva um mês
        // fechado. Opcional porque o mês criado antes do campo não tem a
        // chave.
        allow create, update: if monthId.matches('[0-9]{4}-[0-9]{2}')
                              && request.resource.data.status in ['open', 'closed']
                              && (!('currentWeek' in request.resource.data)
                                  || (request.resource.data.currentWeek is int
                                      && request.resource.data.currentWeek >= 1
                                      && request.resource.data.currentWeek <= 4))
                              && (!('income' in request.resource.data)
                                  || (request.resource.data.income is int
                                      && request.resource.data.income >= 0));
        allow delete: if false;

        // A linha de gasto fixo do mês acompanha o cadastro e também não tem
        // mais ideal próprio; a chave só aparece nas linhas gravadas antes da
        // mudança, e por isso continua aceita e validada. `planId` é copiado
        // do cadastro e marca a linha como gasto fixo de planejamento, e
        // `paidAmount` é o valor guardado quando ele ficou pago em parte.
        match /fixedEntries/{entryId} {
          allow read: if true;
          allow create, update: if request.resource.data.amount is int
                                && request.resource.data.amount >= 0
                                && request.resource.data.status is string
                                && (!('idealAmount' in request.resource.data)
                                    || (request.resource.data.idealAmount is int
                                        && request.resource.data.idealAmount >= 0))
                                && (!('planId' in request.resource.data)
                                    || request.resource.data.planId == null
                                    || request.resource.data.planId is string)
                                && (!('paidAmount' in request.resource.data)
                                    || request.resource.data.paidAmount == null
                                    || (request.resource.data.paidAmount is int
                                        && request.resource.data.paidAmount >= 0));
          // Remover um gasto fixo do cadastro também remove a linha dele do
          // mês em aberto.
          allow delete: if true;
        }

        match /categoryEntries/{entryId} {
          allow read: if true;
          allow create, update: if request.resource.data.idealAmount is int
                                && request.resource.data.idealAmount >= 0
                                && request.resource.data.status is string;
          // Remover uma categoria sem lançamentos no mês remove a linha dela.
          allow delete: if true;
        }

        // Linha de origem do mês: guarda o nome, o gasto ideal e o status de
        // pagamento da origem (o gasto dela é somado na tela, não gravado). É
        // por aqui que a aba Pagamento acompanha o que já foi pago em cada
        // forma de pagamento; sem este bloco ela não lista nem grava status.
        // O ideal é opcional na validação: a linha criada antes do campo
        // existir não tem a chave até a reconciliação do mês completá-la.
        match /originEntries/{entryId} {
          allow read: if true;
          allow create, update: if request.resource.data.name is string
                                && request.resource.data.name.size() > 0
                                && request.resource.data.status is string
                                && (!('idealAmount' in request.resource.data)
                                    || (request.resource.data.idealAmount is int
                                        && request.resource.data.idealAmount >= 0));
          // Origem removida do cadastro e sem gasto no mês perde a linha.
          allow delete: if true;
        }

        match /expenses/{expenseId} {
          allow read: if true;
          // `importKey` é a chave da compra na fatura importada; ausente no
          // lançamento digitado à mão. Ela não entra na lista do update: a
          // ligação com o registro de importação não muda depois de criada.
          allow create: if request.resource.data.amount is int
                        && request.resource.data.amount > 0
                        && request.resource.data.categoryId is string
                        && request.resource.data.categoryName is string
                        && request.resource.data.week is int
                        && request.resource.data.week >= 1
                        && request.resource.data.week <= 4
                        && (!('importKey' in request.resource.data)
                            || request.resource.data.importKey is string);
          // O histórico do mês edita o lançamento inteiro no modal do lápis:
          // valor, descrição, classificação (categoria e origem) e a data do
          // gasto, que traz a semana junto, porque a semana é derivada dela.
          // A reclassificação em lote usa a mesma regra, tocando só a
          // classificação. O documento nunca muda de mês: editar a data
          // reescreve createdAt e week, não move o lançamento de coleção.
          allow update: if request.resource.data.amount is int
                        && request.resource.data.amount > 0
                        && request.resource.data.description is string
                        && request.resource.data.categoryId is string
                        && request.resource.data.categoryId.size() > 0
                        && request.resource.data.categoryName is string
                        && (!('originName' in request.resource.data)
                            || request.resource.data.originName is string)
                        && request.resource.data.createdAt is int
                        && request.resource.data.createdAt > 0
                        && request.resource.data.week is int
                        && request.resource.data.week >= 1
                        && request.resource.data.week <= 4
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['amount', 'description', 'categoryId',
                                       'categoryName', 'originId', 'originName',
                                       'createdAt', 'week']);
          allow delete: if true;
        }
      }
    }
  }
}
